# Use LF for ordinary text files and recognize CRLF when checking whitespace.
* text=auto eol=lf whitespace=cr-at-eol

# Preserve exact bytes for the SHA-256-locked pipeline, benchmark and evidence.
src/** -text
benchmark/** -text
starter/baseline.py -text
requirements.txt -text

# Source excerpts intentionally retain whitespace from the original document.
results/** -text whitespace=cr-at-eol,-blank-at-eol
